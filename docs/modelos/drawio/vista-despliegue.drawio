        <mxCell id="N3" parent="1" style="shape=note;size=12;html=1;whiteSpace=wrap;fontSize=10;fillColor=#FFFDE7;strokeColor=#9A8B4F;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;R-002a · R-004a&lt;/b&gt; · Coordinador, Monitor y Bandeja corre ×1, uno activo, una propuesta posterior es dos en epera (eleccion de lider). Si el Coordinador cae, otro toma su lugar con el fin de que solo uno coordine y no se pierdan pedidos distribuidos en otros nodos.No se toma esta propuesta porque es una mejora que implica infraestructura y esta fuera del alcance" vertex="1">
          <mxGeometry height="94" width="335" x="1340" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="e50" edge="1" parent="1" source="N3" style="html=1;rounded=0;edgeStyle=none;endArrow=none;jumpStyle=arc;jumpSize=8;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#9A8B4F;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F2A36;dashed=1;dashPattern=2 3;exitX=0.4091;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" target="COO" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N4" parent="1" style="shape=note;size=12;html=1;whiteSpace=wrap;fontSize=10;fillColor=#FFFDE7;strokeColor=#9A8B4F;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Propuesta&lt;/b&gt; · el Monitor guarda las señales en su esquema (DG-CLS-001), así una señal no se repite tras reiniciar" vertex="1">
          <mxGeometry height="58" width="320" x="1690" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="e51" edge="1" parent="1" source="N4" style="html=1;rounded=0;edgeStyle=none;endArrow=none;jumpStyle=arc;jumpSize=8;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#9A8B4F;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F2A36;dashed=1;dashPattern=2 3;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4074;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" target="MON" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N5" parent="1" style="shape=note;size=12;html=1;whiteSpace=wrap;fontSize=10;fillColor=#FFFDE7;strokeColor=#9A8B4F;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-001 · S-3&lt;/b&gt; · bróker, base y Lista se registran como 1 nodo son la pieza común de los cuatro caminos (R-001a). Su redundancia es decisión de infraestructura y se marca como fuera del alcance" vertex="1">
          <mxGeometry height="58" width="360" x="2330" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="e52" edge="1" parent="1" source="N5" style="html=1;rounded=0;edgeStyle=none;endArrow=none;jumpStyle=arc;jumpSize=8;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#9A8B4F;strokeWidth=1;fontFamily=Helvetica;fontColor=#1F2A36;dashed=1;dashPattern=2 3;exitX=0.5972;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" target="PG" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LEY" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#1F2A36;fontSize=10;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2B3642&quot;&gt;━━&lt;/font&gt; «HTTPS» llamada síncrona&lt;br&gt;&lt;font color=&quot;#1F6FEB&quot;&gt;╍╍&lt;/font&gt; «AMQP» publica o consume en el bróker&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;━━&lt;/font&gt; «JDBC» camino directo a almacenamiento&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;━━&lt;/font&gt; «REST» muestra camino de revocación y validación de seguridad de acceso&lt;br&gt;&lt;font color=&quot;#8A96A3&quot;&gt;┄┄&lt;/font&gt; métricas&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(255, 140, 128), rgb(153, 51, 255));&quot;&gt;━━&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(255, 140, 128), rgb(0, 0, 0));&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(255, 140, 128), rgb(255, 255, 255));&quot;&gt;Monitoreo de servicios de salud&lt;/span&gt;&lt;br&gt;Amarillo: nodo que aloja una táctica de un ADR&lt;br&gt;Gris: sistema o actor externo&lt;br&gt;Borde punteado: propuesta sin ADR&lt;br&gt;×N: instancias que corren a la vez, las de DG-CON-001&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="290" x="300" y="600" as="geometry" />
        </mxCell>
        <mxCell id="ASR" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#1F2A36;fontSize=11;" value="&lt;b&gt;Por dónde pasa cada ASR&lt;/b&gt;&lt;br&gt;&lt;b&gt;ASR-1 · ≤ 2 s:&lt;/b&gt; Teléfono del vendedor → Balanceador → Puerta → Gestor de sesión (t0) → sesion.abierta → Verificador → alerta.seguridad → Notificador → Área de seguridad&lt;br&gt;&lt;b&gt;ASR-2 · ≤ 5 s:&lt;/b&gt; Equipo del usuario interno → Puerta → Pedidos o Inventario (bitácora y outbox) → escritura.realizada → Detector (t_det) → Gestor (permisos) → Reacción → Redis (revocar) → Gestor (bloquear) → Pedidos o Inventario (compensar) → alerta.seguridad&lt;br&gt;&lt;b&gt;ASR-3 · ≤ 30 s:&lt;/b&gt; Monitor: vencidas al Coordinador cada 5 s y salud de Facturación, Inventario y Validación de despacho → Senal en su esquema → cola.reintentos&lt;br&gt;&lt;b&gt;ASR-4 · ≤ 5 s:&lt;/b&gt; cola.reintentos → Coordinador (CadenaEtapa) → etapa.ejecutar → etapa con EtapaProcesada → etapa.completada · si no confirma en 3 s: cadena.escalada o cola.fallidos → Bandeja → Responsable" vertex="1">
          <mxGeometry height="100" width="2000" x="300" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="ibE2ofhmzIwnzvhXnldT-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1" vertex="1">
          <mxGeometry height="10" width="70" x="910" y="320" as="geometry" />
        </mxCell>
