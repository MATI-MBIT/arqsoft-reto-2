    {
      "type": "table",
      "title": "Cada caída (D2): pedidos detenidos y cuándo la declaró el Monitor",
      "description": "declarada_tras debería rondar N × T.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "registro"
          },
          "rawSql": "SELECT c.falla, c.etapa, c.reinicio - c.falla AS caida,\n       (SELECT min(d.ts) - c.falla FROM registro.e02_declaraciones d\n        WHERE d.etapa = c.etapa AND d.ts >= c.falla AND d.ts <= coalesce(c.reinicio, 'infinity')) AS declarada_tras,\n       count(x.pedido_id) AS detenidos, count(x.encolado) AS encolados, max(x.demora_ms) AS demora_max_ms\nFROM registro.e02_caidas c\nLEFT JOIN registro.e02_cruce x ON x.falla = 'D2' AND x.falla_id = c.falla_id\nWHERE $__timeFilter(c.falla)\nGROUP BY c.falla_id, c.falla, c.etapa, c.reinicio ORDER BY c.falla DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "registro"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 29
    },
    {
      "type": "table",
      "title": "Escapes, duplicados y falsas alarmas",
      "description": "Vacía es lo esperado, salvo los mensajes de pedidos que se recuperaron solos.",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "registro"
          },
          "rawSql": "SELECT t0 AS cuando, 'escape' AS que, falla || ' · ' || etapa AS detalle, pedido_id, demora_ms\nFROM registro.e02_cruce\nWHERE $__timeFilter(t0) AND t0 < now() - interval '30 seconds' AND (encolado IS NULL OR demora_ms > 30000)\nUNION ALL\nSELECT t0, 'duplicado', falla || ' · ' || etapa, pedido_id, demora_ms FROM registro.e02_cruce\nWHERE $__timeFilter(t0) AND mensajes > 1\nUNION ALL\nSELECT ts, 'falsa alarma', etapa, NULL, NULL FROM registro.e02_declaraciones\nWHERE $__timeFilter(ts) AND NOT justificada\nUNION ALL\nSELECT ts, CASE WHEN llego_a_logistica THEN 'mensaje · llegó a logística' ELSE 'mensaje sin detenido' END,\n       etapa, pedido_id, NULL FROM registro.e02_mensajes_falsos WHERE $__timeFilter(ts)\nORDER BY 1 DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "registro"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
