            "uid": "registro"
          },
          "rawSql": "SELECT count(*) FROM registro.e02_atascos WHERE $__timeFilter(ts)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "registro"
      },
      "fieldConfig": {
