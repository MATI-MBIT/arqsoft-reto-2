      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Entregas repetidas descartadas",
      "description": "Entregas de un pedido que la etapa ya había terminado: vio el recibo y no repitió el efecto (D5).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "registro"
          },
          "rawSql": "SELECT count(*) FROM registro.evento WHERE tipo = 'etapa.entrega.repetida' AND $__timeFilter(ts)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "registro"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Efectos dobles",
      "description": "Pedidos a los que una etapa aplicó dos veces su efecto: una factura o un descargue repetido.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "registro"
          },
          "rawSql": "SELECT count(*) FROM (SELECT pedido_id, etapa FROM registro.evento\n                      WHERE tipo = 'etapa.efecto.aplicado' AND $__timeFilter(ts)\n                      GROUP BY pedido_id, etapa HAVING count(*) > 1) d",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "registro"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4
    },
    {
      "type": "state-timeline",
      "title": "Lo que declara el Monitor de cada etapa",
      "description": "Verde: viva. Rojo: declarada detenida tras N sondeos sin respuesta. Las anotaciones rojas marcan cada falla inyectada; las verdes, cada etapa que volvió a responder.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (etapa) (monitor_etapa_detenida)",
          "legendFormat": "{{etapa}}",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "viva",
                  "color": "green"
                },
                "1": {
                  "text": "detenida",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Mensajes en las colas del bróker de la cadena",
      "description": "La Dead-Letter-Queue no tiene consumidor: crece con cada pedido detenido. La cola de una etapa caída acumula su trabajo, que se retoma cuando la etapa vuelve.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue) (rabbitmq_queue_messages{queue=~\"dead-letter-queue|etapa.*\"})",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "pointSize": 6,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "A la Dead-Letter-Queue por segundo: ventas y auditor",
      "description": "Lo que ventas envió con confirmación del bróker y lo que el auditor leyó de la copia. Deben coincidir.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (etapa) (rate(ventas_pedidos_encolados_total[15s]))",
          "legendFormat": "ventas · {{etapa}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (etapa) (rate(auditor_mensajes_total[15s]))",
          "legendFormat": "auditor · {{etapa}}",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "pointSize": 6,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    }
  ],
  "templating": {
    "list": []
  }
}
