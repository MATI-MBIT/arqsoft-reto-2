      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "registro"
          },
          "rawSql": "SELECT count(*) FROM registro.e02_cruce WHERE demora_ms <= 30000 AND $__timeFilter(t0)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
